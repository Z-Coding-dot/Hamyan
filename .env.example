# Local development (use with `npm run dev` — Vite proxies /api → Laravel :8000)
# Put these in `.env.development`, not `.env`, so they are not baked into production builds.
VITE_API_BASE_URL=/api
VITE_API_ORIGIN=http://localhost:8000
VITE_SITE_URL=http://localhost:5176

