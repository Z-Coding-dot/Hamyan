{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hamyan",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "hamyan.ten.af",
      "custom_domain": true
    },
    {
      "pattern": "hamyan.ten.af/*",
      "zone_name": "ten.af"
    }
  ]
}
